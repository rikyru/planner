# Copia in .env e modifica. Nessuna credenziale è scritta nel codice.

# --- Database ---
POSTGRES_DB=planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=cambia-questa-password
# Immagine PostGIS: quella ufficiale è x86 (ok per Mac mini 2015 / NAS Intel).
POSTGIS_IMAGE=postgis/postgis:16-3.4

# --- App ---
APP_PORT=8080
LOG_LEVEL=INFO
# Porta con le sole pagine condivise (/share/...): è l'unica da esporre su Internet.
SHARE_PORT=8081
# Indirizzo pubblico con cui gli altri aprono i link condivisi, es. https://viaggi.example.com
# (deve puntare alla SHARE_PORT). Vuoto = l'indirizzo da cui stai usando l'app.
PUBLIC_BASE_URL=

# --- Mappa (MapLibre style JSON) ---
# Default gratuito senza chiave. Alternative: MapTiler, Stadia, o tiles self-hosted.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=

# --- Geocoding ---
# photon (consigliato, supporta la ricerca mentre si digita) oppure nominatim
GEOCODER=photon
# Lingua dei nomi dei luoghi (Pechino invece di 北京市). Se Photon non la supporta usa l'inglese.
GEOCODER_LANGUAGE=it
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Con Photon, Nominatim serve per "Cerca ancora": conosce i nomi in tutte le lingue (Pechino, Mosca).
# Nominatim richiede uno User-Agent identificabile: metti un tuo contatto.
GEOCODER_USER_AGENT=planner-selfhosted/0.1
