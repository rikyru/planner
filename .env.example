# Copia in .env e modifica. Nessuna credenziale è scritta nel codice.

# --- Database ---
POSTGRES_DB=planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=cambia-questa-password
# Immagine PostGIS: quella ufficiale è x86 (ok per Mac mini 2015 / NAS Intel).
POSTGIS_IMAGE=postgis/postgis:16-3.4

# --- App ---
APP_PORT=8080
LOG_LEVEL=INFO
# URL pubblico per i link di condivisione, es. https://viaggi.example.com (vuoto = stesso host)
PUBLIC_BASE_URL=

# --- Mappa (MapLibre style JSON) ---
# Default gratuito senza chiave. Alternative: MapTiler, Stadia, o tiles self-hosted.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=

# --- Geocoding ---
# photon (consigliato, supporta la ricerca mentre si digita) oppure nominatim
GEOCODER=photon
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim richiede uno User-Agent identificabile: metti un tuo contatto.
GEOCODER_USER_AGENT=planner-selfhosted/0.1
